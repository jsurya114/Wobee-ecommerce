*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Turbo / cache
.turbo/

# Prisma
packages/database/prisma/*.db

# Isolated worktrees for subagent-driven development (Week 2+)
.claude/worktrees/
uploads/

# Personal Claude Code overrides (not shared with the team)
.claude/settings.local.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
tfplan
tfplan.*
terraform-plan-readable.txt
crash.log
crash.*.log
infra/terraform/environments/*/terraform.tfvars
!infra/terraform/environments/*/terraform.tfvars.example
*.auto.tfvars
*.auto.tfvars.json

# Local observability stack: generated Grafana admin password (never commit)
infra/observability/.local-secrets/

# Saved Terraform plans are appliable artifacts and can embed values: never commit them
# (the existing patterns missed names like tfplan-final and terraform-plan-final-readable.txt)
tfplan-*
terraform-plan-*.txt
