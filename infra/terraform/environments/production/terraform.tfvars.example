# Copy to terraform.tfvars and adjust as needed. terraform.tfvars itself
# is gitignored and must never be committed.
#
# Nothing in this configuration currently requires a secret value here:
# the RDS master password is AWS-managed via Secrets Manager
# (manage_master_user_password = true), and the self-hosted Valkey
# password is generated by Terraform itself (random_password) and stored
# only in an SSM SecureString parameter. Neither is ever written to
# terraform.tfvars.

aws_region  = "ap-south-2"
aws_profile = "WoobeTerraformAdmin-185658217213"

project     = "Woobe"
environment = "production"

ec2_instance_type = "t4g.small"
db_instance_class = "db.t4g.micro"

# Set to receive CloudWatch alarm emails; leave blank to skip the subscription.
alert_email = ""
