    {
      "id": 15,
      "type": "bargauge",
      "title": "Requests/sec by route (top 8)",
      "datasource": {
        "type": "prometheus",
        "uid": "woobe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "description": "Route TEMPLATES (/api/v1/orders/:id), never raw URLs. NOT_FOUND = unmatched paths.",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (route) (rate(woobe_http_requests_total[$__range])))",
          "legendFormat": "{{route}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "p95 latency by route (top 8)",
      "datasource": {
        "type": "prometheus",
        "uid": "woobe-prometheus"
