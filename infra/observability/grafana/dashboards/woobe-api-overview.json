        "uid": "woobe-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "description": "Share of requests answered 5xx over 5m. Empty when there is no traffic (deliberately not 0).",
      "targets": [
        {
          "refId": "A",
          "expr": "woobe:http_request_error_ratio:rate5m * 100",
          "legendFormat": "",
          "instant": false
