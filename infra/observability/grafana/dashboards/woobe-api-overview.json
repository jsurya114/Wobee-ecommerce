    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests / sec by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "woobe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(woobe_http_requests_total{status_code=~\"2..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(woobe_http_requests_total{status_code=~\"3..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "3xx"
        },
        {
          "refId": "C",
          "expr": "sum(rate(woobe_http_requests_total{status_code=~\"4..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "4xx"
        },
        {
          "refId": "D",
          "expr": "sum(rate(woobe_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
