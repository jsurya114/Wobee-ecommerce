    {
      "id": 11,
      "type": "timeseries",
      "title": "Jobs completed / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "woobe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "description": "Counted once per job, only when it actually completed \u2014 a retry that later succeeds counts once.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(woobe_notification_jobs_completed_total[$__rate_interval])",
          "legendFormat": "completed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Failures: attempts vs terminal",
      "datasource": {
        "type": "prometheus",
        "uid": "woobe-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "description": "A rising attempt-failure rate with a flat terminal rate means flaky-but-recovering (e.g. SMTP timeouts). Terminal = the job will not run again.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(woobe_notification_job_attempt_failures_total[$__rate_interval])",
          "legendFormat": "failed attempts (incl. retried)"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(woobe_notification_jobs_failed_total[$__rate_interval]))",
          "legendFormat": "terminal: {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
