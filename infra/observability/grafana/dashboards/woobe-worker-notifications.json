{
  "id": null,
  "uid": "woobe-worker-notifications",
  "title": "Woobe Worker / Notifications",
  "description": "BullMQ notification worker: throughput, terminal failures, retries, job duration and queue depth. Source: the worker's own loopback metrics server (a separate process from the API).",
  "tags": [
    "woobe",
    "worker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
