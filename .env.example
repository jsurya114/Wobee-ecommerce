# Copy to .env and fill in real values. Never commit .env.
# Grouped by which app/package consumes each variable.
#
# You don't need to `export` these into your shell — `pnpm run bootstrap`
# (see Readme.md) creates this file from this template if it's missing, and
# apps/api plus every `pnpm run db:*` script now load it automatically
# (Week 2 Day 0 bootstrap remediation). An already-exported shell variable
# still always wins over this file's value, so CI's directly-injected env
# vars are unaffected.

# ── Shared ────────────────────────────────────────────────
NODE_ENV=development

# ── Database — packages/database, consumed only by apps/api (ADR-019) ──
# Host port 5433, not 5432 — see docker-compose.yml comment (port conflict
# with a native Postgres already running on this machine).
DATABASE_URL="postgresql://woobe:woobe_dev_password@localhost:5433/woobe_dev?schema=public"
# Used by `prisma migrate diff` in CI against a throwaway shadow DB — not needed locally.
SHADOW_DATABASE_URL="postgresql://woobe:woobe_dev_password@localhost:5433/woobe_shadow?schema=public"

# ── Redis — apps/api (sessions, rate limiting, reservation TTLs — ADR-017) ──
# Host port 6380, not 6379 — see docker-compose.yml comment (port conflict
# with an unrelated project's Redis container on this machine).
REDIS_URL="redis://localhost:6380"

# ── Auth — apps/api (ADR-018) ──
JWT_ACCESS_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"
BCRYPT_SALT_ROUNDS=12

# ── API server ──
API_PORT=4000
# Address the API binds to. Leave unset locally: every interface, exactly as before. In PRODUCTION,
# where nginx runs on the same host with host networking, set 127.0.0.1 (in /opt/woobe/app/api.env)
# so the API is reachable only over loopback. Must be an IP address: blank or "localhost" fails startup.
# API_BIND_HOST=127.0.0.1
API_BASE_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
COOKIE_DOMAIN="localhost"
COOKIE_SECRET="dev-only-change-me-cookie-secret"
# Reverse-proxy hops the API trusts for the client IP (rate limits key on it).
# Leave unset: 1 in production (behind nginx on the EC2), 0 everywhere else. A blank
# value counts as unset. Setting it above 0 with NO proxy in front lets any client
# forge its IP through X-Forwarded-For.
# TRUST_PROXY_HOPS=1

# ── Razorpay — apps/api (ADR-014). Wired Week 1 Day 5 — still STUBBED here,
# real test-mode keys needed for an actual end-to-end Checkout run (create
# a Razorpay test account, and — for the webhook specifically — a public
# HTTPS tunnel, e.g. ngrok, pointed at /api/v1/payments/razorpay/webhook and
# registered in the Razorpay dashboard, since Razorpay can't reach
# localhost). COD works fully with these stubs, no real keys needed. ──
RAZORPAY_KEY_ID="rzp_test_stub_replace_with_real_test_key"
RAZORPAY_KEY_SECRET="stub_replace_with_real_test_secret"
RAZORPAY_WEBHOOK_SECRET="stub_replace_with_real_webhook_secret"

# ── Media — apps/api. MEDIA_STORAGE_DRIVER picks the MediaStoragePort
# implementation:
#   local  (default) — LocalDiskMediaStorage: files under MEDIA_UPLOAD_DIR, served by
#                      the API's /uploads mount at API_PUBLIC_URL. Dev/tests only —
#                      apps/api REFUSES TO BOOT with NODE_ENV=production + local.
#   s3               — production: the API writes/deletes objects in a PRIVATE S3
#                      bucket using its AWS identity (the EC2 instance role — no
#                      access keys, so none belong here), and returns CloudFront
#                      URLs. Browsers read media from CloudFront only. All three
#                      values below come from `terraform output` (s3_media_bucket_name,
#                      media_public_base_url) and are NOT secrets.
API_PUBLIC_URL="http://localhost:4000"
MEDIA_UPLOAD_DIR="uploads"
# MEDIA_STORAGE_DRIVER="s3"
# AWS_REGION="ap-south-2"
# MEDIA_S3_BUCKET="woobe-production-media-<account-id>"
# MEDIA_PUBLIC_BASE_URL="https://dxxxxxxxxxxxxx.cloudfront.net"   # must be https://

# ── Transactional email (SMTP / nodemailer) — apps/api. Optional. Powers
# BOTH: (1) the synchronous OTP emails (registration verification +
# forgot-password codes) and (2) the async order/payment/shipping/return/
# refund lifecycle emails processed by the notification WORKER.
#
# Leave SMTP_HOST unset for local dev: OTP codes are logged to the API
# console and returned in the register/start & forgot-password responses as
# `devCode`, and lifecycle emails no-op through the StubEmailProvider (the
# persist → queue → worker → mark-sent pipeline still runs).
#
# Set these to any SMTP endpoint (Gmail app password, SES SMTP, Mailtrap,
# Postmark, …) and everything is emailed via nodemailer — `devCode`
# disappears. SMTP_PORT: 587 (STARTTLS) or 465 (SMTP_SECURE=true).
#
# IMPORTANT: the notification worker is a SEPARATE process (`pnpm --filter
# @woobe/api run worker`). It sends every order/return/refund email, so it
# needs the SAME SMTP_* vars as the API `server` process. Set them in both
# process environments. Never log SMTP_PASS; never expose it to the frontend.
# ──
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Woobe <no-reply@yourdomain.com>"
# SUPPORT_EMAIL="hello@woobe.in"   # shown in every email footer (default: hello@woobe.in)
# WEB_ORIGIN is reused for the CTA links in emails (already set above).

# ── Google Sign-In — apps/api (Google Identity Services ID-token flow; no
# client secret needed — verifyIdToken only checks a signed JWT). Optional
# in development: leave unset and POST /api/v1/auth/google fails safely
# with 503 SERVICE_UNAVAILABLE instead of skipping verification. REQUIRED
# in production (env.ts fails fast at boot if unset with NODE_ENV=production).
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your web
# origin(s) under "Authorized JavaScript origins" (no redirect URI needed
# for this flow). ──
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# ── apps/web ──
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── apps/admin ──
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000"
