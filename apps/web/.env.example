# Next.js only auto-loads .env* files from THIS app's own directory, not the
# monorepo root — copy to .env.local for local dev. NEXT_PUBLIC_* vars are
# inlined into the client bundle at build time, so nothing secret belongs here.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Week 2 Day 9 (week2 (1).md §19) — the canonical origin for metadataBase,
# canonical URLs, OpenGraph, robots.txt, and sitemap.xml. Set to the real
# production domain when one exists; localhost is fine for dev/preview
# (Next's own metadataBase docs call out localhost as an expected value
# there, not an error).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
