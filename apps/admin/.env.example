# Next.js only auto-loads .env* files from THIS app's own directory, not the
# monorepo root — copy to .env.local for local dev. NEXT_PUBLIC_* vars are
# inlined into the client bundle at build time, so nothing secret belongs here.
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000"
# Client-review fix (2026-09-03) — resolves relative seed-era image paths
# (see src/lib/resolve-image-url.ts) against the storefront's own public
# origin. Same value/name apps/web's own NEXT_PUBLIC_SITE_URL uses.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
